@* Removed old commented-out sections for clarity *@

<MudTabs Elevation="2" Rounded="true" PanelClass="pa-4">

    <MudTabPanel Text="Version File">
        @if (_versionFile != null)
        {
            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <pre>@DisplayObjectValues(_versionFile, "")</pre>
            </MudPaper>
        }
        else
        {
            <MudText>No version file found.</MudText>
        }
    </MudTabPanel>

    @* create a tab with _defaultLocaleFile content *@
    <MudTabPanel Text="Default Locale File">
        @if (_defaultLocaleFile != null)
        {
            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <pre>@DisplayObjectValues(_defaultLocaleFile, "")</pre>
            </MudPaper>
        }
        else
        {
            <MudText>No default locale file found.</MudText>
        }
    </MudTabPanel>

    @if (_installerFiles != null && _installerFiles.Count > 0)
    {
        foreach (var installerFile in _installerFiles)
        {
            <MudTabPanel Text="Installer File">
                <MudPaper Class="pa-2 mb-2" Outlined="true">
                    <pre>@DisplayObjectValues(installerFile, "")</pre>
                </MudPaper>
            </MudTabPanel>
        }
    }
    else
    {
        <MudText>No installer files found.</MudText>
    }

    @* create a tab with each _localesFiles content *@
    @if (_localesFiles != null && _localesFiles.Count > 0)
    {
        foreach (var localeFile in _localesFiles)
        {
            <MudTabPanel Text="Locale File">
                <MudPaper Class="pa-2 mb-2" Outlined="true">
                    <pre>@DisplayObjectValues(localeFile, "")</pre>
                </MudPaper>
            </MudTabPanel>
        }
    }
    else
    {
        <MudText>No locale files found.</MudText>
    }

</MudTabs>

