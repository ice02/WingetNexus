@using MudBlazor
@using WingetNexus.Shared.Models.Github
@using System.Net.Http
@using System.Net.Http.Json
@using YamlDotNet.Serialization
@using YamlDotNet.Serialization.NamingConventions

@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IYamlFilesService yamlFilesService
@inject IPackageService packageService
@inject ISnackbar Snackbar
@inject HttpClient HttpClient

@* Removed old commented-out sections for clarity *@

<MudTabs Elevation="2" Rounded="true" PanelClass="pa-4">
    @* Iterate over the new dictionary, keyed by ManifestType *@
    @* @foreach (var kvp in _manifestDataByType.OrderBy(x => GetSortOrder(x.Key))) // Order tabs logically
    {
        <MudTabPanel Text="@kvp.Key">
            @foreach (var manifestObject in kvp.Value)
            {
                <MudPaper Class="pa-2 mb-2" Outlined="true">
                    <pre>@DisplayObjectValues(manifestObject, "")</pre>
                </MudPaper>
            }
        </MudTabPanel>
    } *@
    
    <MudTabPanel Text="Version File">
        @if (_versionFile != null)
        {
            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <pre>@DisplayObjectValues(_versionFile, "")</pre>
            </MudPaper>
        }
        else
        {
            <MudText>No version file found.</MudText>
        }
    </MudTabPanel>

    @* create a tab with _defaultLocaleFile content *@
    <MudTabPanel Text="Default Locale File">
        @if (_defaultLocaleFile != null)
        {
            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <pre>@DisplayObjectValues(_defaultLocaleFile, "")</pre>
            </MudPaper>
        }
        else
        {
            <MudText>No default locale file found.</MudText>
        }
        </MudTabPanel>
    
    @if (_installerFiles != null && _installerFiles.Count > 0)
    {
        foreach (var installerFile in _installerFiles)
        {
            <MudTabPanel Text="Installer File">
                <MudPaper Class="pa-2 mb-2" Outlined="true">
                    <pre>@DisplayObjectValues(installerFile, "")</pre>
                </MudPaper>
            </MudTabPanel>
        }
    }
    else
    {
        <MudText>No installer files found.</MudText>
    }

    @* create a tab with each _localesFiles content *@
    @if (_localesFiles != null && _localesFiles.Count > 0)
    {
    foreach (var localeFile in _localesFiles)
    {
    <MudTabPanel Text="Locale File">
        <MudPaper Class="pa-2 mb-2" Outlined="true">
            <pre>@DisplayObjectValues(localeFile, "")</pre>
        </MudPaper>
    </MudTabPanel>
    }
    }
    else
    {
    <MudText>No locale files found.</MudText>
    }

</MudTabs>

<MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => AddToApplications()">Add to applications</MudButton>

@code {
    [Parameter]
    public ApplicationInfo? ApplicationInfo { get; set; }

    [Parameter]
    public EventCallback<ApplicationInfo?> ApplicationInfoChanged { get; set; }

    // New dictionary to store deserialized objects by ManifestType
    private Dictionary<string, List<object>> _manifestDataByType = new();
    // Optional: Store mapping from object back to filename if needed for display
    private Dictionary<object, string> _objectToFileMap = new();

    private string StepStatus = "Processing files...";

    private dynamic _versionFile;
    private dynamic _defaultLocaleFile;
    private List<dynamic> _installerFiles;
    private List<dynamic> _localesFiles;

    private List<Dictionary<string, object>> _yamlData = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await ProcessFilesAsync();
    }

    private async Task AddToApplications()
    {
        if (_versionFile == null || _defaultLocaleFile == null || _installerFiles == null)
        {
            Snackbar.Add("No valid files to process.", Severity.Error);
            return;
        }
        
        try
        {
            // Check and create publisher
            var publisherName = _defaultLocaleFile.Publisher.ToString();
            if (!string.IsNullOrEmpty(publisherName))
            {
                    var newPublisher = new PublisherDto
                        {
                            Name = publisherName,
                            CreatedDate = DateTime.UtcNow,
                            ModifiedDate = DateTime.UtcNow,
                        // Add other properties if needed
                        };
                    newPublisher = await packageService.CreatePublisherAsync(newPublisher);
            }

            // Check and create application
            var applicationName = _versionFile.PackageIdentifier.ToString();
            if (!string.IsNullOrEmpty(applicationName))
            {
                    foreach (var versionFile in _installerFiles) // Itérer sur tous les fichiers de version
                    {
                        try
                        {
                            //var applicationName = versionFile.ContainsKey("PackageIdentifier") ? versionFile["PackageIdentifier"].ToString() : null;
                            var versionNumber = versionFile.VersionNumber.ToString();

                            if (!string.IsNullOrEmpty(applicationName) && !string.IsNullOrEmpty(versionNumber))
                            {
                                var newApp = new ApplicationDto
                                {
                                    Name = applicationName,
                                    Publisher = publisherName,
                                    CreatedDate = DateTime.UtcNow,
                                    ModifiedDate = DateTime.UtcNow,
                                    UserCreated = "System", // Remplacez par l'utilisateur actuel si disponible
                                    UserLastModified = "System", // Remplacez par l'utilisateur actuel si disponible
                                    Versions = new List<VersionDto>
                                    {
                                        new VersionDto
                                        {
                                            VersionNumber = versionNumber,
                                            CreatedDate = DateTime.UtcNow,
                                            ModifiedDate = DateTime.UtcNow,
                                            UserCreated = "System",
                                            UserLastModified = "System"
                                        }
                                    }
                                };

                                newApp = await packageService.CreateApplicationAsync(newApp, versionNumber);
                            }
                        }
                        catch (Exception exc)
                        {
                            Snackbar.Add($"Error adding application for version: {exc.Message}", Severity.Error);
                        }
                    }
                
            }
        }
        catch (Exception exc)
        {
            Snackbar.Add($"Error adding to applications: {exc.Message}", Severity.Error);
        }
    }

    private async Task ProcessFilesAsync()
    {
        if (ApplicationInfo?.YamlFilesList == null) return;

        _yamlData.Clear();
        _versionFile = null; // Reset main file

        foreach (var file in ApplicationInfo.YamlFilesList)
        {
            var fileContent = await GetFileContentFromCacheStorage(file);
            var deserializer = new DeserializerBuilder()
                .WithNamingConvention(CamelCaseNamingConvention.Instance)
                .Build();
            dynamic yamlObject = deserializer.Deserialize<dynamic>(fileContent);
            var manifestVersion = yamlObject["ManifestVersion"];
            var fileType = yamlObject["ManifestType"];

            // Process each file
            try
            {
                var deserializedObject = await yamlFilesService.DeserializeYamlContent(fileType, manifestVersion, fileContent);
                _yamlData.Add(new Dictionary<string, object>
                {
                    { "FileName", file },
                    { "DeserializedObject", deserializedObject }
                });

                // Check if the file is of type "version" and set it as the main file
                if (fileType == "version")
                {
                    _versionFile = deserializedObject;
                }
                else if (fileType == "defaultLocale")
                {
                    _defaultLocaleFile = deserializedObject;
                }
                else if (fileType == "installer")
                {
                    if (_installerFiles == null) _installerFiles = new List<dynamic>();
                    _installerFiles.Add(deserializedObject);
                }
                else if (fileType == "locale")
                {
                    if (_localesFiles == null) _localesFiles = new List<dynamic>();
                    _localesFiles.Add(deserializedObject);
                }
                else
                {
                    Snackbar.Add($"Unknown file type '{fileType}' in file '{file}'", Severity.Error);
                    //_logger.LogWarning($"Unknown file type '{fileType}' in file '{file}'");
                }
            }
            catch (Exception exc)
            {
                Snackbar.Add(exc.Message, Severity.Error);
            }
        }
    }

    // Helper class for initial deserialization to get ManifestType/Version
    private class ManifestBaseInfo {
        public string ManifestType { get; set; }
        public string ManifestVersion { get; set; }
    }

    // Helper method to get a logical sort order for tabs
    private int GetSortOrder(string manifestType)
    {
        return manifestType?.ToLowerInvariant() switch
        {
            "singleton" => 1,
            "version" => 2,
            "defaultlocale" => 3,
            "installer" => 4,
            "locale" => 5,
            _ => 99 // Put unknown types last
        };
    }

     // Helper method to retrieve the original filename (if needed)
    private string GetFileNameForObject(object obj)
    {
        return _objectToFileMap.TryGetValue(obj, out var fileName) ? fileName : "Unknown";
    }

    // DisplayObjectValues remains the same as it works on any object
    private string DisplayObjectValues(object obj, string prefix)
    {
        if (obj == null) return "null";

        // Handle primitive types or types we don't want to recurse into deeply
        if (obj.GetType().IsPrimitive || obj is string || obj is decimal || obj is DateTime || obj is DateTimeOffset)
        {
            return obj.ToString();
        }

        var properties = obj.GetType().GetProperties();
        var result = new List<string>();

        if (properties is null || properties.Length == 0)
        {
             // If it's an enumerable but not string/dictionary, display items
            if (obj is System.Collections.IEnumerable enumerable && !(obj is string || obj is System.Collections.IDictionary))
            {
                 result.Add($"{prefix}[");
                 foreach(var item in enumerable)
                 {
                     result.Add($"{prefix}  - {DisplayObjectValues(item, prefix + "    ")}");
                 }
                 result.Add($"{prefix}]");
                 return string.Join("\n", result);
            }
            return obj.ToString(); // Fallback for simple objects with no props
        }

        foreach (var property in properties)
        {
            // Skip indexer properties
            if (property.GetIndexParameters().Length > 0) continue;

            object value = null;
            try
            {
                value = property.GetValue(obj);
            }
            catch (Exception) // Handle potential exceptions on property access
            {
                continue;
            }

            if (value is null) continue; // Don't display null properties

            string propertyPrefix = $"{prefix}{property.Name}:";

            if (value is System.Collections.IEnumerable enumerable && !(value is string) && !(value is System.Collections.IDictionary))
            {
                result.Add($"{propertyPrefix}");
                bool first = true;
                foreach (var item in enumerable)
                {
                     // Check if item is complex object or simple type
                    if (item != null && (item.GetType().IsClass || item.GetType().IsValueType) && !item.GetType().IsPrimitive && !(item is string) && !(item is DateTime))
                    {
                        // Add indentation for complex objects within lists
                        result.Add($"{prefix}  - {DisplayObjectValues(item, prefix + "    ")}");
                    }
                    else
                    {
                        result.Add($"{prefix}  - {item}");
                    }
                    first = false;
                }
                 if (first) // Handle empty enumerables
                 {
                     result.Add($"{prefix}  []");
                 }
            }
            else if (value is System.Collections.IDictionary dictionary)
            {
                result.Add($"{propertyPrefix}");
                 if (dictionary.Count == 0)
                 {
                     result.Add($"{prefix}  {{}}");
                 }
                 else
                 {
                    foreach (System.Collections.DictionaryEntry entry in dictionary)
                    {
                        result.Add($"{prefix}  {entry.Key}: {DisplayObjectValues(entry.Value, prefix + "    ")}"); // Recurse for dictionary values
                    }
                 }
            }
             // Check if it's a complex object (class or struct, not primitive/string/datetime)
            else if ((value.GetType().IsClass || (value.GetType().IsValueType && !value.GetType().IsEnum))
                     && !value.GetType().IsPrimitive && !(value is string) && !(value is DateTime))
            {
                 // Recurse for nested objects, adding indentation
                 result.Add($"{propertyPrefix}\n{DisplayObjectValues(value, prefix + "  ")}");
            }
            else // Simple property value
            {
                result.Add($"{propertyPrefix} {value}");
            }
        }

        return string.Join("\n", result);
    }

    private async Task<string> GetFileContentFromCacheStorage(string fileName)
    {
        try
        {
            var content = await LocalStorage.GetItemAsync<string>(fileName);
            return content ?? string.Empty; // Return empty string if null
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error reading '{fileName}' from local storage: {ex.Message}", Severity.Error);
            return string.Empty;
        }
    }

    // This method might be redundant now if you don't need a raw dictionary transformation elsewhere.
    // private async Task<Dictionary<string, object>> TransformYamlToDictionaryAsync(string yamlFilePath)
    // {
    //     // ... (implementation as before) ...
    // }
}
