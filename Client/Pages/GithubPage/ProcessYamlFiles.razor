    private async Task ProcessFilesAsync()
    {
        if (ApplicationInfo?.YamlFilesList == null) return;

        //_yamlData.Clear();
        _versionFile = null; // Reset main file

        foreach (var file in ApplicationInfo.YamlFilesList)
        {
            var fileContent = file.FileContent; //await GetFileContentFromCacheStorage(file);
            var deserializer = new DeserializerBuilder()
                .WithNamingConvention(CamelCaseNamingConvention.Instance)
                .Build();
            
            dynamic yamlObject = deserializer.Deserialize<dynamic>(fileContent);

            var manifestVersion = yamlObject["ManifestVersion"];
            var manifestType = yamlObject["ManifestType"];

            // Process each file
            try
            {
                var deserializedObject = await yamlFilesService.DeserializeYamlContent(manifestType, manifestVersion, fileContent);
                // _yamlData.Add(new Dictionary<string, object>
                // {
                //     { "FileName", file },
                //     { "DeserializedObject", deserializedObject }
                // });

                // Check if the file is of type "version" and set it as the main file
                if (manifestType == "version")
                {
                    _versionContent = fileContent;
                    _versionFile = deserializedObject;
                }
                else if (manifestType == "defaultLocale")
                {
                    _defaultLocaleContent = fileContent;
                    _defaultLocaleFile = deserializedObject;
                }
                else if (manifestType == "installer")
                {
                    if (_installerFiles == null) _installerFiles = new List<dynamic>();
                    _installerFiles.Add(deserializedObject);

                    _installerContent = fileContent;
                }
                else if (manifestType == "locale")
                {
                    if (_localesFiles == null) _localesFiles = new List<dynamic>();
                    _localesFiles.Add(deserializedObject);

                    _localesContent.Add(fileContent);
                }
                else
                {
                    Snackbar.Add($"Unknown file type '{manifestType}' in file '{file}'", Severity.Error);
                    //_logger.LogWarning($"Unknown file type '{fileType}' in file '{file}'");
                }
            }
            catch (Exception exc)
            {
                Snackbar.Add(exc.Message, Severity.Error);
            }
        }
    }

    private string DisplayObjectValues(object obj, string prefix)
    {
        if (obj == null) return "null";

        // Handle primitive types or types we don't want to recurse into deeply
        if (obj.GetType().IsPrimitive || obj is string || obj is decimal || obj is DateTime || obj is DateTimeOffset)
        {
            return obj.ToString();
        }

        var properties = obj.GetType().GetProperties();
        var result = new List<string>();

        if (properties is null || properties.Length == 0)
        {
            // If it's an enumerable but not string/dictionary, display items
            if (obj is System.Collections.IEnumerable enumerable && !(obj is string || obj is System.Collections.IDictionary))
            {
                result.Add($"{prefix}[");
                foreach (var item in enumerable)
                {
                    result.Add($"{prefix}  - {DisplayObjectValues(item, prefix + "    ")}");
                }
                result.Add($"{prefix}]");
                return string.Join("\n", result);
            }
            return obj.ToString(); // Fallback for simple objects with no props
        }

        foreach (var property in properties)
        {
            // Skip indexer properties
            if (property.GetIndexParameters().Length > 0) continue;

            object value = null;
            try
            {
                value = property.GetValue(obj);
            }
            catch (Exception) // Handle potential exceptions on property access
            {
                continue;
            }

            if (value is null) continue; // Don't display null properties

            string propertyPrefix = $"{prefix}{property.Name}:";

            if (value is System.Collections.IEnumerable enumerable && !(value is string) && !(value is System.Collections.IDictionary))
            {
                result.Add($"{propertyPrefix}");
                bool first = true;
                foreach (var item in enumerable)
                {
                    // Check if item is complex object or simple type
                    if (item != null && (item.GetType().IsClass || item.GetType().IsValueType) && !item.GetType().IsPrimitive && !(item is string) && !(item is DateTime))
                    {
                        // Add indentation for complex objects within lists
                        result.Add($"{prefix}  - {DisplayObjectValues(item, prefix + "    ")}");
                    }
                    else
                    {
                        result.Add($"{prefix}  - {item}");
                    }
                    first = false;
                }
                if (first) // Handle empty enumerables
                {
                    result.Add($"{prefix}  []");
                }
            }
            else if (value is System.Collections.IDictionary dictionary)
            {
                result.Add($"{propertyPrefix}");
                if (dictionary.Count == 0)
                {
                    result.Add($"{prefix}  {{}}");
                }
                else
                {
                    foreach (System.Collections.DictionaryEntry entry in dictionary)
                    {
                        result.Add($"{prefix}  {entry.Key}: {DisplayObjectValues(entry.Value, prefix + "    ")}"); // Recurse for dictionary values
                    }
                }
            }
            // Check if it's a complex object (class or struct, not primitive/string/datetime)
            else if ((value.GetType().IsClass || (value.GetType().IsValueType && !value.GetType().IsEnum))
                     && !value.GetType().IsPrimitive && !(value is string) && !(value is DateTime))
            {
                // Recurse for nested objects, adding indentation
                result.Add($"{propertyPrefix}\n{DisplayObjectValues(value, prefix + "  ")}");
            }
            else // Simple property value
            {
                result.Add($"{propertyPrefix} {value}");
            }
        }

        return string.Join("\n", result);
    }

    
