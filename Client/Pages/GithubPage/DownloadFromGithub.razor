@using WingetNexus.Shared.Models.Github
@using YamlDotNet.Serialization
@using YamlDotNet.Serialization.NamingConventions

@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IGithubService GithubApiService

@if (ApplicationInfo != null)
{
    <MudTextField @bind-Value="ApplicationInfo.Publisher" Label="Publisher" Disabled="true" />
    <MudTextField @bind-Value="ApplicationInfo.Name" Label="Application Name" Disabled="true" />
    <MudTextField @bind-Value="ApplicationInfo.Version" Label="Version" Disabled="true" />
    <MudTextField @bind-Value="ApplicationInfo.FilePath" Label="File Path" Disabled="true" />

    @if (yamlFilesList != null && yamlFilesList.Any())
    {
        <MudList T="DirectoryContent">
            @foreach (var item in yamlFilesList)
            {
                <MudListItem>
                    @item.Name
                    <MudProgressLinear Value="@item.DownloadProgress" BufferValue="100" />
                    <MudText>@item.DownloadStatus</MudText>
                </MudListItem>
            }
        </MudList>
    }
}

@code {
    [Parameter]
    public ApplicationInfo? ApplicationInfo { get; set; }

    [Parameter]
    public EventCallback<ApplicationInfo?> ApplicationInfoChanged { get; set; }

    private List<DirectoryContent> yamlFilesList = new List<DirectoryContent>();

    protected override async Task OnInitializedAsync()
    {
        if (ApplicationInfo != null && !string.IsNullOrEmpty(ApplicationInfo.FilePath))
        {
            yamlFilesList = (await GithubApiService.GetDirectoryContent(ApplicationInfo.FilePath)).ToList();
            await DownloadFilesToStorage();
        }
    }

    private async Task DownloadFilesToStorage()
    {
        if (yamlFilesList == null || !yamlFilesList.Any())
        {
            return;
        }

        if (ApplicationInfo != null)
        {
            ApplicationInfo.YamlFilesList = new List<ContentFileDto>();
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userEmail = user.Identity?.IsAuthenticated == true ? user.FindFirst(c => c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")?.Value : "Unknown";


        foreach (var item in yamlFilesList)
        {
            item.DownloadStatus = "Downloading to temp storage...";
            StateHasChanged();

            var fileContent = item.DownloadUrl != null ? await DownloadFileDirectlyAsync(item.DownloadUrl) : null;
            if (fileContent != null)
            {
                //await StoreFileInCacheStorage(item.Name, fileContent);
                item.DownloadProgress = 100;
                item.DownloadStatus = "Downloaded ...";
                StateHasChanged();

                var deserializer = new DeserializerBuilder()
                    .WithNamingConvention(CamelCaseNamingConvention.Instance)
                    .Build();
                dynamic yamlObject = deserializer.Deserialize<dynamic>(fileContent);
                var manifestVersion = yamlObject["ManifestVersion"];
                var manifestType = yamlObject["ManifestType"];

                if (ApplicationInfo != null && ApplicationInfo.YamlFilesList != null)
                {
                    var newContentFile = new ContentFileDto
                        {
                            FilePath = item.DownloadUrl,
                            FileName = item.Name,
                            FileContent = fileContent,
                            FileType = manifestType,
                            FileVersion = manifestVersion,
                            FileExtension = "yaml",
                            CreatedDate = DateTime.UtcNow,
                            ModifiedDate = DateTime.UtcNow,
                            UserCreated = userEmail,
                            UserLastModified = userEmail,
                            RepositoryType = "Database",
                            Checksum = CalculateChecksum(fileContent)
                        };
                    ApplicationInfo.YamlFilesList.Add(newContentFile);
                }

                item.DownloadStatus = "Content files created";
            }
            else
            {
                item.DownloadStatus = "Failed to download";
            }

            StateHasChanged();
        }

        await ApplicationInfoChanged.InvokeAsync(ApplicationInfo);
    }


    private string CalculateChecksum(string fileContent)
    {
        using (var sha256 = System.Security.Cryptography.SHA256.Create())
        {
            var bytes = System.Text.Encoding.UTF8.GetBytes(fileContent);
            var hash = sha256.ComputeHash(bytes);
            return Convert.ToBase64String(hash);
        }
    }

    private async Task<string> DownloadFileDirectlyAsync(string filePath)
    {
        using (var httpClient = new HttpClient())
        {
            try
            {
                return await httpClient.GetStringAsync(filePath);
            }
            catch
            {
                return null;
            }
        }
    }

    // private async Task StoreFileInCacheStorage(string fileName, string fileContent)
    // {
    //     await LocalStorage.SetItemAsync(fileName, fileContent);
    // }
}
