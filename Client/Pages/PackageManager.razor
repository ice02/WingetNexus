@page "/packagemanager"

@using WingetNexus.Client.Modals
@using WingetNexus.Shared.Models
@using WingetNexus.Shared.Models.Dtos

@attribute [Authorize]
@* @attribute [RenderModeInteractiveAuto] *@

@inject IPackageService PackageService

@inject MudBlazor.ISnackbar snackBar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IAntiforgeryHttpClientFactory HttpClientFactory

@if (!isPageLoaded)
{
    <MudProgressCircular Class="m-auto" Color="Color.Primary" Size="Size.Large" />
}
else
{
    
<MudPaper Elevation="25" Class="ma-4">
    <MudToolBar>
        <MudText Typo="Typo.h6">Winget Applications</MudText>
        <MudChip T="string">@packages.Count() application(s)</MudChip>
        @* <MudChip>@packages.Select(p=>p.Versions).Count() versions(s)</MudChip> *@
        <MudSpacer />
        <MudButton @onclick="OpenDialogQuickAdd" Variant="Variant.Filled" Color="Color.Primary">Add new application</MudButton>
        @* <MudButton @onclick="OpenNew" Variant="Variant.Filled" Color="Color.Primary">Add new package</MudButton> *@
    </MudToolBar>
</MudPaper>

@* @if (noPackage)
{
    <MudText Class="mt-1">No package found</MudText>
}
else
{ *@

    <MudDataGrid Elevation="25" Class="ma-4" Loading=@isLoading FixedHeader="true" ServerData="LoadGridData" T="ApplicationDto" @ref="_dataGrid" >
        <NoRecordsContent>
            <MudText Class="mt-1">No application found</MudText>
        </NoRecordsContent>
        <ToolBarContent>
                <MudTextField @bind-Value="_requestDto.SearchTerm" Placeholder="Search for applications..." Adornment="Adornment.Start" Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                <MudIconButton Size="@Size.Small" Color="Color.Primary" Icon="@Icons.Material.Outlined.Search" OnClick="@Search" />

        </ToolBarContent>
        <Columns>
            <PropertyColumn Title="Publisher" Property="x => x.Publisher.Name" />
            <PropertyColumn Title="Application Name" Property="x => x.Name" />
            <PropertyColumn Title="Identifier" Property="x => x.PackageIdentifier" />
            <PropertyColumn Property="x => x.Versions" Title="Latest version">
                <CellTemplate>
                    @(context.Item.LatestVersion?.VersionNumber ?? "No available version")
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn CellClass="d-flex justify-end">
                <CellTemplate>
                    <MudIconButton Size="@Size.Small" Color="Color.Primary" Icon="@Icons.Material.Outlined.Edit" @onclick="@(()=>OpenDialogUpdate(@context.Item))" />
                    <MudIconButton Size="@Size.Small" Color="Color.Secondary" Icon="@Icons.Material.Outlined.Delete" @onclick="@(()=>Delete(@context.Item.PackageIdentifier))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="ApplicationDto" />
        </PagerContent>
    </MudDataGrid>

@* } *@
}

@code {
    bool isPageLoaded = false;

    private MudDataGrid<ApplicationDto>? _dataGrid;

    private string searchString = "";
    private IEnumerable<ApplicationDto> packages = new List<ApplicationDto>();
    private bool isLoading = false;
    private bool noPackage = false;

    private GridDataRequestDto _requestDto = new();
    private DataListDto<ApplicationDto> dataListDto = new();

    protected override async Task OnInitializedAsync()
    {
        await PackageService.InitializeHttpClientAsync(await HttpClientFactory.CreateClientAsync());
        await base.OnInitializedAsync();
        isPageLoaded = true;
        StateHasChanged();
        //await Task.Delay(1);
    }

    private async Task<GridData<ApplicationDto>> LoadGridData(GridState<ApplicationDto> state)
    {
        dataListDto.Page = state.Page;
        dataListDto.PageSize = state.PageSize;
        //dataListDto.SortBy = state.SortDefinitions.FirstOrDefault().SortBy;
        //dataListDto.IsAscending = state.SortedColumn?.SortDirection;
        dataListDto.Filter = searchString;

        _requestDto = new GridDataRequestDto
            {
                Page = state.Page,
                PageSize = state.PageSize
            };


        DataListDto<ApplicationDto> apiResponse = await PackageService.GetPackagesFilteredAsync(_requestDto);
        if (apiResponse == null || apiResponse.Items == null)
        {
            return new GridData<ApplicationDto>();
        }

        GridData<ApplicationDto> data = new()
        {
            Items = apiResponse.Items,
            TotalItems = apiResponse.ItemTotalCount,
        };

        StateHasChanged();

        return data;
    }

    private async Task Search()
    {
        if (_dataGrid is not null)
        {
            await _dataGrid!.ReloadServerData();
        }
    }

    private async Task OpenDialogQuickAdd()
    {
        var options = new DialogOptions { CloseOnEscapeKey = false, MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AddApplication>("Add a new application", options);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var data = result.Data as ApplicationDto;
            //redirect to the edit page using data.PackageIdentifier parameter
            NavigationManager.NavigateTo("/packageEdit/" + data.PackageIdentifier);
        }
    }

    private async void Delete(string id)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Warning",
            "Deleting can not be undone!",
            yesText: "Delete!", cancelText: "Cancel");
        if (confirm == true)
        {
            try
            {
                await PackageService.DeletePackageAsync(id);
                snackBar.Add("Application fully deleted", Severity.Success);

                await _dataGrid.ReloadServerData();
            }
            catch (Exception ex)
            {
                snackBar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private void OpenNew()
    {
        NavigationManager.NavigateTo("/packageEdit");
    }

    private void OpenDialogUpdate(ApplicationDto package)
    {
        NavigationManager.NavigateTo("/packageEdit/" + package.PackageIdentifier);
    }

}
