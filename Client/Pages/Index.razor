@page "/"

@attribute [Authorize]

@inject IApplicationService ApplicationService

<PageTitle>Winget Nexus home page</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Welcome</MudText>

<MudText Class="mb-8">
    Use the <a href="">Application</a> link on the left to add packages and versions.
</MudText>



@if (Tutorials.Any(t => !t.Dismissed))
{
    <MudGrid>
        @foreach (var tutorial in Tutorials.Where(t => !t.Dismissed))
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6">@tutorial.Title</MudText>
                    <MudText>@tutorial.Content</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="() => DismissTutorial(tutorial.Id)">Close</MudButton>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">Dashboard</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Number of Applications</MudText>
                    <MudText Typo="Typo.h4">@NumberOfApplications</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private int NumberOfApplications;
    private List<Tutorial> Tutorials = new();

    protected override async Task OnInitializedAsync()
    {
        NumberOfApplications = await ApplicationService.GetNumberOfApplicationsAsync();
        Tutorials = await ApplicationService.GetTutorialsAsync();
    }

    private async Task DismissTutorial(int tutorialId)
    {
        var tutorial = Tutorials.FirstOrDefault(t => t.Id == tutorialId);
        if (tutorial != null)
        {
            tutorial.Dismissed = true;
            await ApplicationService.SaveTutorialDismissedStateAsync(tutorialId, true);
        }
    }
}

