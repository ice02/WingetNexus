@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Headers

@attribute [Authorize]

@inject MudBlazor.ISnackbar snackBar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors" Model="@Version">
            @if (errors.Length > 0)
            {
                @* <MudAlert Severity="Severity.Error" Elevation="0" Class="mud-width-full mb-4">
                    <MudAlertTitle>Error</MudAlertTitle>
                    <MudAlertDescription>
                        <ul>
                            @foreach (var error in errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </MudAlertDescription>
                </MudAlert>
            } *@
                <MudPaper Class="pa-4 mud-height-full">
                    <MudText Typo="Typo.subtitle2">@($"Errors ({errors.Length})")</MudText>
                    @foreach (var error in errors)
                    {
                        <MudText Color="@Color.Error">@error</MudText>
                    }
                </MudPaper>
            }

            <MudPaper Class="mud-width-full mb-4 pa-4">
                @* adding field for version form  *@            
                @* TODO: use a component *@
                <MudTextField T="string" Label="Version" Required="true" RequiredError="Version is required!" 
                @bind-Value="Version.VersionNumber" For="@(() => Version.VersionNumber)" />
                <MudTextField T="string" Label="Short Description" Required="true" RequiredError="Description is required!"
                @bind-Value="Version.ShortDescription" For="@(() => Version.ShortDescription)" />
                <MudTextField T="string" Label="Default locale" Required="true" RequiredError="Localization is required!"
                              @bind-Value="Version.DefaultLocaleKey" For="@(() => Version.DefaultLocaleKey)" />
                @* create a drop downlist to choose manifest version based on a static list *@
                <MudSelect T="string" Label="Winget cli manifest version" @bind-Value="Version.ManifestVersion">
                    <MudSelectItem Value="1.4">1.4</MudSelectItem>
                    <MudSelectItem Value="1.5">1.5</MudSelectItem>
                    <MudSelectItem Value="1.6">1.6</MudSelectItem>
                    <MudSelectItem Value="1.7">1.7</MudSelectItem>
                    <MudSelectItem Value="1.9">1.9</MudSelectItem>
                    <MudSelectItem Value="1.10">1.10</MudSelectItem>
                </MudSelect>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12">
                    <InstallerList Version="@Version" ManifestVersion="@Version.ManifestVersion" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>

</MudDialog>

@code
{
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public VersionDto Version { get; set; }

    private bool success;
    private string[] errors = { };
    private MudForm? form;

    protected async override Task OnInitializedAsync()
    {
        //TODO: call api to find all available manifest versions

        await base.OnInitializedAsync();
    }

    void Submit()
    {
        if (string.IsNullOrEmpty(this.Version.VersionNumber) || string.IsNullOrEmpty(this.Version.ShortDescription) || string.IsNullOrEmpty(this.Version.DefaultLocaleKey))
        {
            snackBar.Add("Mandatory informations are missing", Severity.Warning);
            return;
        }

        // call api to insert version in database





        // if (form!.IsValid)
        // {
            MudDialog.Close(DialogResult.Ok(Version));
        //}
    }
    void Cancel() => MudDialog.Cancel();
}