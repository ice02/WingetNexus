@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Headers

@attribute [Authorize]

@inject MudBlazor.ISnackbar snackBar
@inject IAntiforgeryHttpClientFactory httpClientFactory

<MudDialog>
    <DialogContent>
        @if (Version == null)
        {
            <MudText Class="mt-1">Version initializing ...</MudText>
        }
        else
        {
        <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors" Model="@Version">
            @if (errors != null && errors.Length > 0)
            {
                @* <MudAlert Severity="Severity.Error" Elevation="0" Class="mud-width-full mb-4">
                    <MudAlertTitle>Error</MudAlertTitle>
                    <MudAlertDescription>
                        <ul>
                            @foreach (var error in errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </MudAlertDescription>
                </MudAlert>
            } *@
                <MudPaper Class="pa-4 mud-height-full">
                    <MudText Typo="Typo.subtitle2">@($"Errors ({errors.Length})")</MudText>
                    
                        @foreach (var error in errors)
                        {
                            <MudText Color="@Color.Error">@error</MudText>
                        }
                    
                </MudPaper>
            }

            <MudPaper Class="mud-width-full mb-4 pa-4">
                @* adding field for version form  *@            
                @* TODO: use a component *@
                <MudTextField T="string" Label="Version" Required="true" RequiredError="Version is required!" 
                @bind-Value="Version.VersionNumber" For="@(() => Version.VersionNumber)" />
                <MudTextField T="string" Label="Short Description" Required="true" RequiredError="Description is required!"
                @bind-Value="Version.ShortDescription" For="@(() => Version.ShortDescription)" />
                <MudSelect T="string" Label="Default locale" Required="true" RequiredError="Localization is required!"
                @bind-Value="Version.DefaultLocaleValue" For="@(() => Version.DefaultLocaleValue)">
                    <MudSelectItem Value="@("en-US")">en-US</MudSelectItem>
                    <MudSelectItem Value="@("fr-FR")">fr-FR</MudSelectItem>
                </MudSelect>
                @* create a drop downlist to choose manifest version based on a static list *@
                <MudSelect T="string" Label="Winget cli manifest version" @bind-Value="Version.ManifestVersion">
                    <MudSelectItem Value="@("1.4.0")">1.4</MudSelectItem>
                    <MudSelectItem Value="@("1.5.0")">1.5</MudSelectItem>
                    <MudSelectItem Value="@("1.6.0")">1.6</MudSelectItem>
                    <MudSelectItem Value="@("1.7.0")">1.7</MudSelectItem>
                    <MudSelectItem Value="@("1.9.0")">1.9</MudSelectItem>
                    <MudSelectItem Value="@("1.10.0")">1.10</MudSelectItem>
                </MudSelect>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12">
                        @if (Version.Installers == null)
                        {
                            <InstallerEdit VersionModel="@Version" ManifestVersion="@Version.ManifestVersion" />
                        }
                        else
                        {
                            <InstallerList Version="@Version" ManifestVersion="@Version.ManifestVersion" />
                        }
                </MudItem>
            </MudGrid>
        </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>

</MudDialog>

@code
{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public VersionDto? Version { get; set; }
    [Parameter] public string? ApplicationIdentifier { get; set; }

    private bool success;
    private string[] errors = { };
    private MudForm? form;
    private bool isEdit = false;
    private HttpClient client = null;


    protected async override Task OnInitializedAsync()
    {
        //TODO: call api to find all available manifest versions

        client = await httpClientFactory.CreateClientAsync();

        // check if the version is null
        if (Version == null)
        {
            Version = new VersionDto();
            Version.VersionNumber = "1.0.0";
            Version.ShortDescription = "Initial version";
            Version.DefaultLocaleValue = "en-US";
            Version.ManifestVersion = "1.10";
        }
        else
        {
            isEdit = true;
        }

        await base.OnInitializedAsync();
    }

    void Submit()
    {
        if (string.IsNullOrEmpty(this.Version.VersionNumber) 
        || string.IsNullOrEmpty(this.Version.ShortDescription) 
        || string.IsNullOrEmpty(this.Version.DefaultLocaleValue)
        || string.IsNullOrEmpty(this.Version.ManifestVersion)
        )
        {
            snackBar.Add("Mandatory informations are missing", Severity.Warning);
            return;
        }

        // call api to insert version in database
        if (!isEdit)
        {
            client.PostAsJsonAsync($"api/v2/versions/application/{ApplicationIdentifier}", Version)
                .ContinueWith(task =>
                {
                    if (task.IsCompletedSuccessfully)
                    {
                        var result = task.Result;
                        if (result.IsSuccessStatusCode)
                        {
                            snackBar.Add("Version added successfully", Severity.Success);
                            var resultContent = task.Result.Content.ReadFromJsonAsync<VersionDto>();
                            MudDialog.Close(DialogResult.Ok(resultContent));
                        }
                        else
                        {
                            snackBar.Add("Error adding version", Severity.Error);
                        }
                    }
                });
        }
        else
        {
            client.PutAsJsonAsync($"api/v2/versions/{Version.Id}", Version)
                .ContinueWith(task =>
                {
                    if (task.IsCompletedSuccessfully)
                    {
                        var result = task.Result;
                        if (result.IsSuccessStatusCode)
                        {
                            snackBar.Add("Version updated successfully", Severity.Success);
                            var resultContent = task.Result.Content.ReadFromJsonAsync<VersionDto>();
                            MudDialog.Close(DialogResult.Ok(resultContent));
                        }
                        else
                        {
                            snackBar.Add("Error updating version", Severity.Error);
                        }
                    }
                });
        }
    }
    void Cancel() => MudDialog.Cancel();
}