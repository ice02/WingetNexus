    private RenderFragment GetVersionEditor()
    {
        //return builder => { builder.OpenComponent(0, typeof(Components._1_10_0.InstallerEditor)); builder.CloseComponent(); };

        var manifestVersion = ManifestVersion.Split('.');
        var componentPath = $"WingetNexus.Client.Components._{manifestVersion[0]}_{manifestVersion[1]}_0.InstallerEditor";
        var componentType = Type.GetType(componentPath);
        if (componentType != null)
        {
            return builder =>
            {
                builder.OpenComponent(0, componentType);
                builder.AddAttribute(1, "InstallerModel", InstallerModel);
                builder.CloseComponent();
            };
        }
        else
        {
            return builder =>
            {
                builder.AddContent(0, $"No installer found for manifest {ManifestVersion}");
            };
        }
    }
