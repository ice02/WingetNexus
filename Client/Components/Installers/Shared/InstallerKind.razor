
<MudSelect T="string" Label="Select Installer Type" @bind-Value="SelectedInstallerType">
    <MudSelectItem Value="@("Msix")">msix</MudSelectItem>
    <MudSelectItem Value="@("Msi")">msi</MudSelectItem>
    <MudSelectItem Value="@("Appx")">appx</MudSelectItem>
    <MudSelectItem Value="@("Exe")">exe</MudSelectItem>
    <MudSelectItem Value="@("Zip")">zip</MudSelectItem>
    <MudSelectItem Value="@("Inno")">inno</MudSelectItem>
    <MudSelectItem Value="@("Nullsoft")">nullsoft</MudSelectItem>
    <MudSelectItem Value="@("Wix")">wix</MudSelectItem>
    <MudSelectItem Value="@("Burn")">burn</MudSelectItem>
    <MudSelectItem Value="@("Pwa")">Progressive Web App</MudSelectItem>
    <MudSelectItem Value="@("Portable")">portable</MudSelectItem>
</MudSelect>

@if (SelectedInstallerType == "Zip")
{
    <MudSelect T="string" Label="Select Nested Installer Type" @bind-Value="SelectedNestedInstallerType">
        <MudSelectItem Value="@("Msix")">msix</MudSelectItem>
        <MudSelectItem Value="@("Msi")">msi</MudSelectItem>
        <MudSelectItem Value="@("Appx")">appx</MudSelectItem>
        <MudSelectItem Value="@("Exe")">exe</MudSelectItem>
        <MudSelectItem Value="@("Inno")">inno</MudSelectItem>
        <MudSelectItem Value="@("Nullsoft")">nullsoft</MudSelectItem>
        <MudSelectItem Value="@("Wix")">wix</MudSelectItem>
        <MudSelectItem Value="@("Burn")">burn</MudSelectItem>
        <MudSelectItem Value="@("Portable")">portable</MudSelectItem>
    </MudSelect>
}

@if (SelectedInstallerType == "Zip")
{
    <MudTextField T="string" @bind-Value="RelativeFilePath"
                  Label="Relative File Path" HelperText="The relative path to the nested installer file" Required="true" />
    <MudTextField T="string" @bind-Value="PortableCommandAlias"
                  Label="Portable Command Alias" HelperText="The command alias to be used for calling the package" />
}

@code {
    private string selectedInstallerType = "Msi";
    private string selectedNestedInstallerType = "Portable";
    private string relativeFilePath;
    private string portableCommandAlias;

    [Parameter]
    public string SelectedInstallerType
    {
        get => selectedInstallerType;
        set
        {
            if (selectedInstallerType != value)
            {
                selectedInstallerType = value;
                SelectedInstallerTypeChanged.InvokeAsync(value);
            }
        }
    }

    [Parameter] public EventCallback<string> SelectedInstallerTypeChanged { get; set; }

    [Parameter]
    public string SelectedNestedInstallerType
    {
        get => selectedNestedInstallerType;
        set
        {
            if (selectedNestedInstallerType != value)
            {
                selectedNestedInstallerType = value;
                SelectedNestedInstallerTypeChanged.InvokeAsync(value);
            }
        }
    }

    [Parameter] public EventCallback<string> SelectedNestedInstallerTypeChanged { get; set; }

    [Parameter]
    public string RelativeFilePath
    {
        get => relativeFilePath;
        set
        {
            if (relativeFilePath != value)
            {
                relativeFilePath = value;
                RelativeFilePathChanged.InvokeAsync(value);
            }
        }
    }

    [Parameter] public EventCallback<string> RelativeFilePathChanged { get; set; }

    [Parameter]
    public string PortableCommandAlias
    {
        get => portableCommandAlias;
        set
        {
            if (portableCommandAlias != value)
            {
                portableCommandAlias = value;
                PortableCommandAliasChanged.InvokeAsync(value);
            }
        }
    }

    [Parameter] public EventCallback<string> PortableCommandAliasChanged { get; set; }
}
